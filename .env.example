# Anthropic Claude API Anahtari
# https://console.anthropic.com adresinden alin
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Meta / Instagram API
# Meta Developer panelinden alin
